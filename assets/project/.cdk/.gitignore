# Keep operational records local while allowing the directory placeholders
# to ship in the CLI package. Each rule below ignores contents but re-includes
# the placeholder file needed to materialize the directory on fresh installs.
/journal/*
!/journal/.gitkeep
/experiences/*
!/experiences/.gitkeep
/uat/*
!/uat/.gitkeep
/incidents/*
!/incidents/.gitkeep

# Local scratch and temporary validation data.
*.tmp
*.local
